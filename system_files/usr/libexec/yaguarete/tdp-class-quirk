#!/usr/bin/bash
# Make PowerStation see this machine's iGPU as integrated.
#
# PowerStation decides whether a card gets a TDP interface from its PCI class,
# and the mapping is inverted for every modern handheld
# (src/performance/gpu/dbus/gpu.rs, still on main as of 0.8.1):
#
#     "030000" => "integrated"    <- what discrete desktop GPUs report
#     "038000" => "dedicated"     <- what Strix/Phoenix iGPUs report
#
# `get_tdp_interface()` only returns something for "integrated", so on the
# F1 Pro PowerStation logs "Card Card1 does not have a TDP interface",
# steamos-manager reports TdpLimitMin = TdpLimitMax = 0, and Steam hides the
# TDP slider in the QAM. Reported upstream; until it lands, we hand
# PowerStation the class it expects.
#
# Scope: the drop-in sets PrivateMounts=yes and makes this the ExecStart, so
# the bind mount lives in PowerStation's own mount namespace. Nothing else on
# the system sees a different PCI class, and the mount dies with the service.
#
# This has to `exec` PowerStation itself rather than run as an ExecStartPre.
# PrivateMounts gives *every* Exec* invocation its own mount namespace, not one
# shared by the unit: a mount made in ExecStartPre is gone by the time
# ExecStart runs. Shipped that way once and the quirk was inert -- it logged
# success, the mount was real, and PowerStation still read 0x038000 because it
# was looking at a different namespace.
#
# When upstream fixes the mapping this becomes wrong rather than redundant --
# a corrected PowerStation would read our 030000 and classify it as discrete.
# The failure mode is the symptom we started from (no slider), not damage, and
# it goes away by deleting this file and its drop-in. Do that when the fix
# reaches us.
#
# Failing to quirk is never fatal: PowerStation must start either way, on every
# machine that does not need this. The last line of the script is the exec, so
# the service runs whether or not the mount happened.

set -uo pipefail

readonly WANTED=0x038000
readonly EXPECTED=0x030000
readonly RUNDIR=/run/yaguarete/tdp

log() { echo "[tdp-class-quirk] $*"; }

# Only AMD cards, and only the ones reporting the class PowerStation gets
# wrong. A discrete Radeon reports 0x030000 and is left alone.
patched=0
for dev in /sys/class/drm/card*/device; do
    [[ -r $dev/class && -r $dev/vendor ]] || continue
    [[ "$(cat "$dev/vendor")" == "0x1002" ]] || continue
    [[ "$(cat "$dev/class")" == "$WANTED" ]] || continue

    real=$(readlink -f "$dev") || continue
    if mountpoint -q "$real/class"; then
        log "$real/class ya estaba montado, no toco nada"
        continue
    fi

    mkdir -p "$RUNDIR" || continue
    printf '%s\n' "$EXPECTED" >"$RUNDIR/class" || continue
    if mount --bind "$RUNDIR/class" "$real/class"; then
        log "$real: $WANTED -> $EXPECTED"
        patched=$((patched + 1))
    else
        log "no pude montar sobre $real/class, sigo sin el quirk"
    fi
done

(( patched == 0 )) && log "ninguna GPU necesita el quirk"

# Hand the namespace, mount and all, to the real service.
exec "$@"
