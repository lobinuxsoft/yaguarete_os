---
import HeroSection from '@components/sections/landing/HeroSection.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import type { Translations } from '@utils/i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;

const heroTitle = `<span class="text-orange-500 dark:text-orange-400">${t.hero.titlePrefix}</span>${t.hero.titleSuffix}`;
---

{/* Hero is wrapped so BackgroundScroller's IntersectionObserver can pick it
    up as #hero. The side-column image prop is intentionally omitted: the
    fullscreen wallpaper behind the page already serves as the hero visual. */}
<section id="hero">
  <HeroSection
    title={heroTitle}
    subTitle={t.hero.subTitle}
    primaryBtn={t.hero.primaryBtn}
    primaryBtnURL={t.hero.primaryBtnUrl}
  />
</section>

{/* Variants */}
<section
  id="variants"
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
>
  <div class="mb-10 max-w-2xl">
    <h2 class="text-2xl font-bold text-neutral-100 md:text-3xl lg:text-4xl">
      {t.variants.title}
    </h2>
    <p class="mt-2 text-neutral-300">{t.variants.subTitle}</p>
  </div>

  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      t.variants.cards.map(variant => (
        <li class="flex flex-col rounded-2xl border border-neutral-700/60 bg-neutral-950/60 p-6 shadow-2xl shadow-black/30 backdrop-blur-md">
          <h3 class="font-mono text-sm font-bold break-all text-orange-400">
            {variant.name}
          </h3>
          <p class="mt-1 text-sm font-medium text-neutral-100">{variant.tag}</p>
          <p class="mt-3 grow text-sm text-neutral-300">
            {variant.description}
          </p>
          <dl class="mt-4 text-xs">
            <dt class="text-neutral-400">{t.variants.upstreamLabel}</dt>
            <dd class="font-mono text-neutral-200">{variant.upstream}</dd>
          </dl>
          <div class="mt-5">
            <button
              type="button"
              disabled
              aria-disabled="true"
              title={t.variants.pendingNote}
              class="inline-flex w-full cursor-not-allowed items-center justify-center gap-x-2 rounded-lg border border-neutral-700 bg-neutral-800/60 px-3 py-2 text-sm font-medium text-neutral-400"
            >
              {t.variants.downloadLabel}
            </button>
            <p class="mt-2 text-[0.7rem] leading-snug text-neutral-500">
              {t.variants.pendingNote}
            </p>
          </div>
        </li>
      ))
    }
  </ul>

  <p class="mt-6 text-sm text-neutral-400">{t.variants.cosignNote}</p>
</section>

{/* Stack — replaces the previous Soberanía / Herencia blocks with a single
    short section: Bazzite underneath, dev + gaming on top. */}
<div id="stack">
  <FeaturesGeneral
    title={t.stack.title}
    subTitle={t.stack.subTitle}
    features={t.stack.features}
  />
</div>

{/* FAQ */}
<div id="faq">
  <FAQ
    title={t.faq.title}
    faqs={{ subTitle: t.faq.subTitle, faqs: t.faq.items }}
  />
</div>
