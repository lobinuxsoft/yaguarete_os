---
import type { Translations } from '@utils/i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
---

<section
  id="tools"
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
>
  <div class="mb-10 max-w-3xl">
    <h1 class="text-2xl font-bold text-neutral-100 md:text-3xl lg:text-4xl">
      {t.tools.heading}
    </h1>
    <p class="mt-2 text-neutral-300">{t.tools.intro}</p>
  </div>

  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      t.tools.cards.map(app => {
        const cmd = `ujust install-${app.id}`;
        const deepLink = `yaguarete://install/${app.id}`;
        return (
          <li class="flex flex-col rounded-2xl border border-neutral-700/60 bg-neutral-950/60 p-6 shadow-2xl shadow-black/30 backdrop-blur-md">
            <h2 class="font-mono text-sm font-bold break-all text-orange-400">
              {app.name}
            </h2>
            <p class="mt-1 text-sm font-medium text-neutral-100">{app.tag}</p>
            <p class="mt-3 grow text-sm text-neutral-300">{app.description}</p>

            <dl class="mt-4 text-xs">
              <dt class="text-neutral-400">{t.tools.upstreamLabel}</dt>
              <dd class="font-mono text-neutral-200">
                {app.upstreamUrl ? (
                  <a
                    href={app.upstreamUrl}
                    rel="noopener"
                    class="hover:text-orange-300"
                  >
                    {app.upstream}
                  </a>
                ) : (
                  app.upstream
                )}
              </dd>
            </dl>

            <div class="mt-5 flex flex-col gap-2">
              <a
                href={deepLink}
                class="inline-flex w-full items-center justify-center gap-x-2 rounded-lg bg-orange-500 px-3 py-2 text-sm font-semibold text-neutral-950 transition hover:bg-orange-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-400 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
              >
                {t.tools.installLabel}
              </a>
              <button
                type="button"
                data-copy-target={cmd}
                data-copy-default={t.tools.copyLabel}
                data-copy-done={t.tools.copiedLabel}
                class="inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-neutral-700 bg-neutral-800/40 px-3 py-2 font-mono text-xs text-neutral-200 transition hover:bg-neutral-800/80 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-400 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
              >
                {cmd}
              </button>
            </div>
          </li>
        );
      })
    }
  </ul>

  <p class="mt-6 max-w-3xl text-sm text-neutral-400">
    {t.tools.commandNote}
  </p>
</section>

<script is:inline>
  // Copy the ujust command to the clipboard when the user clicks the
  // mono-spaced command button. The button's own text is the command,
  // which we briefly replace with the localised "Copied ✓" label.
  document.addEventListener('click', event => {
    const btn = event.target.closest('[data-copy-target]');
    if (!btn) return;
    const cmd = btn.dataset.copyTarget;
    const done = btn.dataset.copyDone || 'Copied ✓';
    const initial = btn.textContent;
    navigator.clipboard
      .writeText(cmd)
      .then(() => {
        btn.textContent = done;
        setTimeout(() => {
          btn.textContent = initial;
        }, 1500);
      })
      .catch(() => {});
  });
</script>
