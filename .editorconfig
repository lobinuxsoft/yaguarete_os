# EditorConfig — https://editorconfig.org
# Top-level configuration for YaguareteOS contributors.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Shell scripts: 4 spaces is the de-facto standard and matches the
# Bazzite / Universal Blue upstream style.
[*.sh]
indent_size = 4

# Markdown: trailing whitespace can be a hard line break, do not strip.
[*.md]
trim_trailing_whitespace = false

# Makefiles require literal tabs.
[Makefile]
indent_style = tab

# Justfile uses recipe-body indentation that mirrors Make.
[Justfile]
indent_style = tab

# Containerfile / Dockerfile: 4 spaces, matches upstream conventions.
[{Containerfile,Dockerfile,Dockerfile.*}]
indent_size = 4

# Python (in case build helpers appear later).
[*.py]
indent_size = 4
